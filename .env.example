# ========================================================
# PulseChat Environment Configuration Template
# ========================================================

# BACKEND CONFIGURATION
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/pulsechat
JWT_SECRET=super_secret_session_signing_key_replace_in_production
CLIENT_ORIGIN=https://pulse-chat-pearl.vercel.app
COOKIE_SECURE=false

# WEBRTC STUN / TURN CONFIGURATION
STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN server for strict symmetric NAT environments
# TURN_SERVER=turn:turn.pulsechat.net:3478
# TURN_USERNAME=pulseuser
# TURN_CREDENTIAL=pulsepassword

# FRONTEND CONFIGURATION (Vite)
# (In development Vite proxies /api, /socket.io to localhost:5001)
VITE_API_URL=https://pulsechat-api-r7v2.onrender.com
VITE_SOCKET_URL=https://pulsechat-api-r7v2.onrender.com
